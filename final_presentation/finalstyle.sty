    \begin{beamercolorbox}[wd=.5\paperwidth,ht=2.25ex,dp=1ex,left]{author in head/foot}%
      \hspace*{1.5ex}\insertshortauthor%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.5\paperwidth,ht=2.25ex,dp=1ex,right]{title in head/foot}%
      \insertshorttitle\hspace*{2ex}\insertframenumber\,/\,\inserttotalframenumber\hspace*{1.5ex}%
    \end{beamercolorbox}%
  }\vskip0pt%
}

% Gap between columns: every \column{w} is set \colgap narrower than requested.
% Beamer spreads the freed space evenly before, between and after the columns,
% so blocks standing side by side no longer touch each other or the slide edge.
% (Copy of beamer's \beamer@columncom with only the minipage width changed.)
\newlength{\colgap}
\setlength{\colgap}{4mm}
\renewcommand<>\beamer@columncom[2][\beamer@colmode]{%
  \beamer@colclose%
  \def\beamer@colclose{\end{minipage}\hfill\end{actionenv}\ignorespaces}%
  \begin{actionenv}#3%
  \setkeys{beamer@col}{#1}%
  \ifbeamer@colheight
    \begin{minipage}[\beamer@colalign][\beamer@colheight]{\dimexpr#2-\colgap\relax}%
  \else
    \begin{minipage}[\beamer@colalign]{\dimexpr#2-\colgap\relax}%
  \fi
  \leavevmode\raggedright\beamer@colheadskip\ignorespaces}

