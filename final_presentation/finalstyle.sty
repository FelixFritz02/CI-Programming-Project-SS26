  \begin{tikzpicture}
    \begin{axis}[
        width=#1, height=#2,
        symbolic x coords={5,10,20,50}, xtick=data,
        xticklabels={{$T_d{=}5$\\[-1pt]\tiny 3 inst.},{$T_d{=}10$\\[-1pt]\tiny 18 inst.},{$T_d{=}20$\\[-1pt]\tiny 18 inst.},{$T_d{=}50$\\[-1pt]\tiny 11 inst.}},
        xticklabel style={align=center, font=\scriptsize},
        enlarge x limits=0.14,
        ymin=80, ymax=101, ytick={80,85,90,95,100},
        yticklabel={\pgfmathprintnumber{\tick}\,\%},
        yticklabel style={font=\scriptsize},
        ylabel={mean reward in \% of $Z^*$}, ylabel style={font=\scriptsize},
        axis x line*=bottom, axis y line*=left,
        ymajorgrids, grid style={gray!20, solid},
        axis line style={gray!60}, tick style={gray!60},
        legend style={at={(0.02,0.04)}, anchor=south west, draw=none, fill=white, fill opacity=0.85, text opacity=1, font=\scriptsize, legend columns=1},
