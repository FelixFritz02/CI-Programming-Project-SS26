      \node[anchor=west, font=\scriptsize] at (axis cs:50,86.24) {\ 86.2\,\%};
    \end{axis}
  \end{tikzpicture}}

%------------------------------------------------------------------------------
%  Chart 2: lowest final monotonicity score of the Standard-DQN per axis over
%  all 50 instances (report Tables 2+3); Lattice-DQN = 1.00 everywhere.
%------------------------------------------------------------------------------
\newcommand{\MonotonicityChart}[2]{% #1 width, #2 height
  \begin{tikzpicture}
    \begin{axis}[
        width=#1, height=#2,
        xbar, bar width=7pt,
        xmin=0, xmax=1.0,
        xtick={0,0.25,0.5,0.75,1}, xticklabel style={font=\scriptsize, /pgf/number format/fixed, /pgf/number format/precision=2},
        symbolic y coords={mixed,q_k,r,t,C_k}, ytick={mixed,q_k,r,t,C_k},
        yticklabels={mixed,$q_k$,$r$,$t$,$C_k$},
        yticklabel style={font=\scriptsize},
        enlarge y limits=0.16,
        axis x line*=bottom, axis y line*=left,
        xmajorgrids, grid style={gray!20, solid},
        axis line style={gray!60}, tick style={gray!60},
        xlabel={lowest score over all 50 instances}, xlabel style={font=\scriptsize},
        clip=false,
      ]
      \addplot[fill=stdcol, draw=none] coordinates {(0.94,C_k) (0.69,t) (0.99,r) (0.71,q_k) (0.97,mixed)};
      % Lattice-DQN reference: 1.00 everywhere, by construction
      \draw[latcol, line width=1.6pt] (axis cs:1,{[normalized]-0.55}) -- (axis cs:1,{[normalized]4.55});
      \node[anchor=south, font=\scriptsize, align=center] at (axis cs:1,{[normalized]4.55}) {Lattice-DQN: 1.00};
      % value column: Standard-DQN minimum and the instance where it occurs
      \node[anchor=west, font=\scriptsize] at (axis cs:1.03,C_k)   {0.94 (WC02)};
      \node[anchor=west, font=\scriptsize] at (axis cs:1.03,t)     {0.69 (SB08)};
      \node[anchor=west, font=\scriptsize] at (axis cs:1.03,r)     {0.99 (SB07)};
      \node[anchor=west, font=\scriptsize] at (axis cs:1.03,q_k)   {0.71 (SC01)};
      \node[anchor=west, font=\scriptsize] at (axis cs:1.03,mixed) {0.97 (WC04)};
    \end{axis}
  \end{tikzpicture}}

%------------------------------------------------------------------------------
%  Chart 3 (version 1): mean AND lowest final monotonicity score of the
%  Standard-DQN per component over all 50 instances (report Tables 2+3);
%  Lattice-DQN = 1.00 everywhere. Means rounded to two decimals like the
%  report (C_k 0.9914, t 0.9736, r 0.9998, q_k 0.9800, mixed 0.9994).
%  Light blue = lighter step of the Standard-DQN blue (ordinal pair:
%  dL 0.22, contrast 2.0:1 on white, every bar carries a value label).
%------------------------------------------------------------------------------
\definecolor{stdlight}{HTML}{8DBBDD}
\newcommand{\MonotonicityMeanMinChart}[2]{% #1 width, #2 height
  \begin{tikzpicture}
    \begin{axis}[
        width=#1, height=#2,
        xbar, bar width=6pt,
        xmin=0, xmax=1.0,
        xtick={0,0.25,0.5,0.75,1}, xticklabel style={font=\scriptsize, /pgf/number format/fixed, /pgf/number format/precision=2},
        symbolic y coords={mixed,q_k,r,t,C_k}, ytick={mixed,q_k,r,t,C_k},
        yticklabels={mixed,$q_k$,$r$,$t$,$C_k$},
        yticklabel style={font=\small},
        enlarge y limits=0.13,
        axis x line*=bottom, axis y line*=left,
        xmajorgrids, grid style={gray!20, solid},
        axis line style={gray!60}, tick style={gray!60},
        xlabel={monotonicity score}, xlabel style={font=\scriptsize},
        legend style={at={(0,1.02)}, anchor=south west, draw=none, font=\scriptsize, legend columns=2,
          /tikz/every even column/.append style={column sep=10pt}},
        legend image code/.code={\fill[##1] (0cm,-0.09cm) rectangle (0.35cm,0.09cm);},
        clip=false,
      ]
      \addplot[fill=stdcol, draw=none, bar shift=4.2pt]
        coordinates {(0.99,C_k) (0.97,t) (1.00,r) (0.98,q_k) (1.00,mixed)};
      \addlegendentry{mean over 50 instances}
      \addplot[fill=stdlight, draw=none, bar shift=-4.2pt]
        coordinates {(0.94,C_k) (0.69,t) (0.99,r) (0.71,q_k) (0.97,mixed)};
      \addlegendentry{lowest value (instance)}
      % Lattice-DQN reference: 1.00 everywhere, by construction
      \draw[latcol, line width=1.6pt] (axis cs:1,{[normalized]-0.6}) -- (axis cs:1,{[normalized]4.6});
      \node[anchor=south, font=\scriptsize] at (axis cs:1,{[normalized]4.6}) {Lattice-DQN: 1.00};
      % value column, aligned with the two bars of each row
      \foreach \ax/\m/\lo in {C_k/0.99/{0.94 (WC02)}, t/0.97/{0.69 (SB08)}, r/1.00/{0.99 (SB07)},
                            q_k/0.98/{0.71 (SC01)}, mixed/1.00/{0.97 (WC04)}}{
        \edef\temp{\noexpand\node[anchor=west, font=\noexpand\scriptsize, yshift=4.2pt] at (axis cs:1.03,\ax) {\m};
                   \noexpand\node[anchor=west, font=\noexpand\scriptsize, yshift=-4.2pt] at (axis cs:1.03,\ax) {\lo};}\temp}
    \end{axis}
  \end{tikzpicture}}

