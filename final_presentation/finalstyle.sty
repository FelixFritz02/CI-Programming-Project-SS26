%------------------------------------------------------------------------------
%  Graphic 1: the DRAUSP decision (adapted from the report, Fig. 1)
%------------------------------------------------------------------------------
\newcommand{\ProblemGraphic}{%
  \begin{tikzpicture}[font=\scriptsize,
      slot/.style={draw, minimum width=10mm, minimum height=8mm},
      occ/.style ={draw, fill=orange!25, minimum width=10mm, minimum height=8mm},
      >={Latex[length=2mm]}]
    % incoming request
    \node[draw, rounded corners, fill=tugreen!10, align=center, minimum width=34mm] (req) at (2.2,1.95)
      {\textbf{incoming request} $(r, q)$\\ reward $r$, demand $q=(q_1,q_2,q_3)$};
    % before
    \node[anchor=east] at (-0.6,0.6) {before:};
    \foreach \k/\x in {1/0,2/1.1,3/2.2,4/3.3,5/4.4}{
      \node[slot] (b\k) at (\x,0.6) {$\Chat_\k$};}
    \draw[decorate, decoration={brace, amplitude=4pt}] (0.65,1.08) -- (3.85,1.08)
      node[midway, above=4pt, fill=white, inner sep=1pt] {accept at start slot $a=2$};
    % after
    \node[anchor=east] at (-0.6,-0.9) {after:};
    \node[slot] (a1) at (0,-0.9) {$\Chat_1$};
    \node[occ]  (a2) at (1.1,-0.9) {$\Chat_2{-}q_1$};
    \node[occ]  (a3) at (2.2,-0.9) {$\Chat_3{-}q_2$};
    \node[occ]  (a4) at (3.3,-0.9) {$\Chat_4{-}q_3$};
    \node[slot] (a5) at (4.4,-0.9) {$\Chat_5$};
    \foreach \k in {1,5}{\draw[->, dashed, gray] (b\k) -- (a\k);}
    \foreach \k in {2,3,4}{\draw[->] (b\k) -- (a\k);}
    \node[below=1pt, gray] at (a3.south) {\tiny $K=5$ slots, remaining capacity $\Chat_k$};
  \end{tikzpicture}}

%------------------------------------------------------------------------------
%  Graphic 2: Lattice-DQN pipeline (simplified from the report, Fig. 3)
%------------------------------------------------------------------------------
\newcommand{\LatticePipeline}{%
  \begin{tikzpicture}[font=\scriptsize, node distance=3.5mm,
      box/.style={draw, rounded corners, align=center, minimum height=17mm, text width=22.5mm, fill=##1},
      box/.default=gray!10, >={Latex[length=2mm]}]
    \node[box=gray!10]   (in)  {\textbf{State}\\[2pt] $t,\ C_k,\ r,\ q_k$};
    \node[box=blue!8,   right=of in]  (cal) {\textbf{Calibrators}\\[2pt] monotone map\\ to $[0,1]$;\\ flip $t$ and $q_k$};
    \node[box=red!12,   right=of cal] (l1)  {\textbf{Lattices}\\ \textbf{per resource}\\[2pt] $2{\times}2{\times}2$\\ lattice cubes per resource $k$};
    \node[box=violet!14,right=of l1]  (l2)  {\textbf{Lattices}\\ \textbf{across resources}\\[2pt] couple different\\ resources};
    \node[box=yellow!25,right=of l2]  (out) {\textbf{Output}\\[2pt] linear layer,\\ weights $\geq 0$\\[2pt] $\Rightarrow Q(s,a)$};
    \foreach \a/\b in {in/cal, cal/l1, l1/l2, l2/out}{\draw[->, thick] (\a) -- (\b);}
    \draw[decorate, decoration={brace, mirror, amplitude=5pt}, tugreen, thick]
      ($(cal.south west)+(0,-0.12)$) -- ($(out.south east)+(0,-0.12)$)
      node[midway, below=6pt, text=black] {every stage is monotone $\Rightarrow$ the whole network is monotone, \textbf{by construction}};
  \end{tikzpicture}}

%------------------------------------------------------------------------------
